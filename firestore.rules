rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // A profile can only be read and written by the person it belongs to.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Events published by organizers. Any signed-in person can read them. An event
    // records who published it, and only that person can change or delete it.
    // The organizer role itself is still checked in the app; before a real launch,
    // move it to a custom claim and also require it here:
    //   && request.auth.token.organizer == true
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    // Registrations: one document per person per event, named
    // "<eventId>__<date>__<uid>". Any signed-in person can read them (for live
    // counts and attendee lists); you can only create or remove your own.
    match /registrations/{registrationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && registrationId == request.resource.data.eventId + '__' + request.resource.data.eventDate + '__' + request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Discussion messages: signed-in people can read and post. A message can be
    // changed only to update its like count, and can never be deleted from the client.
    match /campus_chats/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
      allow delete: if false;
    }

    match /dispatched_emails/{emailId} {
      allow read, write: if false;
    }
  }
}
